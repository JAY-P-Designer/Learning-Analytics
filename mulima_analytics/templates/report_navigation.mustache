{{!
    Shared navigation for the DIE reporting suite.
}}
<nav class="die-moodle-nav" aria-label="{{label}}">
    {{#items}}
        <a href="{{url}}"{{#active}} class="die-active" aria-current="page"{{/active}}>{{label}}</a>
    {{/items}}
    {{#showsettings}}
        <a class="die-settings-link" href="{{settingsurl}}">
            <i class="fa fa-cog" aria-hidden="true"></i>&nbsp;{{settingslabel}}
        </a>
    {{/showsettings}}
</nav>
